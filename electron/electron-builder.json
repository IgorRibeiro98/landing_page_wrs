{
    "appId": "autoatendimento",
    "asar": true,
    "productName": "autoatendimento",
    "directories": {
        "buildResources": "assets",
        "output": "release/${version}"
    },
    "files": [
        "dist"
    ],
    "extraFiles": [
        {
          "from": "setting.json",
          "to": "setting.json"
        }
    ],
    "electronLanguages": [
        "pt-BR"
    ],
    "win": {
        "icon": "../src/assets/logo.png",
        "artifactName": "${productName} v${version}.${ext}"
    },
    "linux": {
        "icon": "../src/assets/logo.png",
        "category": "AudioVideo",
        "target": [
            {
                "target": "deb"
            }
        ],
        "artifactName": "${productName} v${version}.${ext}"
    },
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": false,
        "deleteAppDataOnUninstall": false
    }
}